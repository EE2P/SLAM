<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rs_slam_bringup</name>
  <version>0.1.0</version>
  <description>RGB-D SLAM bringup for RealSense D455/D435i: camera + IMU filter + RTAB-Map + Foxglove bridge</description>
  <maintainer email="han.li124@imperial.ac.uk">han</maintainer>
  <license>MIT</license>

  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
