<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rs_nav_bringup</name>
  <version>0.1.0</version>
  <description>RealSense D455/D435i camera-only fallback: RTAB-Map RGB-D SLAM + Nav2 navigation (forward-FOV obstacle avoidance) when the LiDAR is unavailable</description>
  <maintainer email="han.li124@imperial.ac.uk">han</maintainer>
  <license>MIT</license>

  <!-- Camera + RGB-D SLAM -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <!-- Reused RTAB-Map parameter yamls live in rs_slam_bringup -->
  <exec_depend>rs_slam_bringup</exec_depend>

  <!-- TF / navigation -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>spatio_temporal_voxel_layer</exec_depend>

  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
